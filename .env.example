# === Telegram ===
# Token bot lấy từ @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# ID Telegram của admin (bạn). Nhiều admin thì ngăn cách bằng dấu phẩy.
# Lấy ID của bạn bằng cách nhắn cho @userinfobot
ADMIN_IDS=123456789

# === QR chuyển khoản SePay ===
# Tài khoản ngân hàng đã liên kết với SePay.
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_CODE=MB
# Tạo chuỗi bí mật riêng và nhập cùng chuỗi này khi tạo Bank Webhook trên SePay.
SEPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# === Cổng thanh toán SePay cũ (không bắt buộc cho đơn QR mới) ===
SEPAY_MERCHANT_ID=YOUR_MERCHANT_ID
SEPAY_SECRET_KEY=YOUR_SECRET_KEY
# Nếu IPN dùng secret riêng thì điền; bỏ trống sẽ dùng SEPAY_SECRET_KEY
SEPAY_IPN_SECRET=
# Production. Sandbox đổi thành https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
# HTTPS công khai để SePay gọi /payments/sepay/webhook
SEPAY_PUBLIC_BASE_URL=https://pay.example.com
# CARD, BANK_TRANSFER hoặc NAPAS_BANK_TRANSFER
SEPAY_PAYMENT_METHOD=BANK_TRANSFER

# Server nội bộ nhận webhook/IPN (đặt sau Nginx/Caddy HTTPS)
PAYMENT_SERVER_HOST=127.0.0.1
PAYMENT_SERVER_PORT=8080

# === Vận hành (có thể để mặc định) ===
# Số phút giữ đơn trước khi tự huỷ nếu chưa thanh toán.
ORDER_TIMEOUT_MINUTES=15
# Đường dẫn file DB SQLite
DB_PATH=jollibee.db

# === Checker Jollibee ===
# Khoảng nghỉ tối thiểu giữa các request kiểm tra.
VOUCHER_CHECK_INTERVAL=1.5
# Mỗi dòng: host:port, host:port:user:pass hoặc URL proxy đầy đủ.
JOLLIBEE_PROXY_FILE=proxy.txt
# Route bị Jollibee rate-limit sẽ bị bỏ qua trong khoảng thời gian này.
JOLLIBEE_ROUTE_COOLDOWN_SECONDS=1800
# Header app-version hiện dùng bởi API Jollibee (tự động nâng cấp khi Jollibee yêu cầu bản mới).
JOLLIBEE_APP_VERSION=4.10
